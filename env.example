# Configure valores reais somente em Environment no Render.
DATABASE_URL=postgresql://usuario:senha@host/banco
DATABASE_SSL=disable
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=
KLS_ADMIN_USER=admin
KLS_ADMIN_PASSWORD=
# Opcional no Render: usa RENDER_EXTERNAL_URL automaticamente.
# Para domínio próprio, informe somente a origem HTTPS, sem /beauty ou /mercado.
APP_URL=
# Opcional: manter o mercado em outro banco já existente.
# KLS_DATABASE_URL=postgresql://...

# Novo acesso exclusivo à administração da plataforma (mínimo 12 caracteres).
SUPERADMIN_EMAIL=seu-email@exemplo.com
SUPERADMIN_PASSWORD=
